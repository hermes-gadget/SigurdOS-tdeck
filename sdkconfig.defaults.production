# Production ESP32-S3 security fragment for SigurdOS T-Deck (#1210).
# NOT applied by default. Merge with sdkconfig.defaults only for a production
# candidate build, then provision eFuses with an offline process.
#
# WARNING: Flash encryption release mode and Secure Boot eFuse burns are
# irreversible. Never enable these options on a unit you still need to
# reflash with ordinary esptool without a signed recovery path.

# --- Secure Boot V2 (requires signed bootloader + app) ---
# CONFIG_SECURE_BOOT=y
# CONFIG_SECURE_BOOT_V2_ENABLED=y
# CONFIG_SECURE_SIGNED_ON_BOOT=y
# CONFIG_SECURE_SIGNED_ON_UPDATE=y

# --- Flash encryption (release mode after first encrypt boot) ---
# CONFIG_SECURE_FLASH_ENC_ENABLED=y
# CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y

# --- Anti-rollback (pairs with app_desc.secure_version / SIGURDOS_SECURITY_EPOCH) ---
# CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=y

# --- Disable insecure download once provisioned ---
# CONFIG_SECURE_DISABLE_ROM_DL_MODE=y
# CONFIG_SECURE_ENABLE_SECURE_ROM_DL_MODE=y

# Keep UART console available during bring-up builds; disable on sealed units
# only after evidence capture.
# CONFIG_ESP_CONSOLE_UART_NONE=y
